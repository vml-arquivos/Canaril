# Copie para .env SOMENTE no servidor/local. Nunca versione o arquivo preenchido.
POSTGRES_USER=vittabird
POSTGRES_PASSWORD=gere-uma-senha-forte
POSTGRES_DB=vittabird
APP_PORT=3000

DATABASE_URL=postgresql://vittabird:gere-uma-senha-forte@postgres:5432/vittabird
JWT_SECRET=gere-com-openssl-rand-base64-48
SESSION_SECRET=gere-com-openssl-rand-base64-48
CSRF_SECRET=gere-com-openssl-rand-hex-32

OWNER_NAME=Administrador
OWNER_OPEN_ID=local-admin
# Opcional: bootstrap administrativo legado. Prefira criar usuário no painel.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_ID=vittabird
VITE_APP_TITLE=VittaBird
VITE_APP_LOGO=
NODE_ENV=production
PORT=3000
APP_TIME_ZONE=America/Sao_Paulo
CORS_ORIGIN=https://seu-dominio.com.br
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
UPLOADS_DIR=/app/uploads
